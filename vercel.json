{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/judge",
      "destination": "/judge.html"
    },
    {
      "source": "/judge/",
      "destination": "/judge.html"
    },
    {
      "source": "/sponsor",
      "destination": "/sponsor.html"
    },
    {
      "source": "/sponsor/",
      "destination": "/sponsor.html"
    }
  ],
  "headers": [
    {
      "source": "/acalanes-data-fest-sponsorship.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"acalanes-data-fest-sponsorship.pdf\""
        }
      ]
    }
  ]
}
